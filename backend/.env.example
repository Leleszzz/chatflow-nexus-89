# Copie para .env e preencha. O .env NUNCA vai para o git.
PORT=3030
DATA_DIR=./data

# Origem pública do frontend. Em NODE_ENV=production o boot é recusado se
# isto continuar apontando para localhost.
CORS_ORIGIN=http://localhost:8080

# OBRIGATÓRIO. Mínimo de 32 caracteres; sem ele o servidor não sobe.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor invalida todas as sessões ativas (é o procedimento de
# resposta a incidente se ele vazar).
JWT_SECRET=

# Cifragem em repouso das chaves de API de terceiros (OpenAI/Groq/AssemblyAI)
# guardadas no MongoDB. 32 bytes em hexadecimal (64 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_KEY=

# OBRIGATÓRIO em produção (HTTPS). Sem isto o cookie de sessão não exige TLS.
COOKIE_SECURE=false

# Habilite autenticação no MongoDB e use credenciais aqui:
# mongodb://usuario:senha@127.0.0.1:27018/?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB=chatflow

# Idade máxima (dias) de mídia do histórico que ainda vale a pena baixar. 0 = sem limite.
HISTORY_MEDIA_MAX_AGE_DAYS=60

# Teto de upload da lista de leads, em MB.
LEADS_MAX_MB=128

# Faxina de mídia órfã (arquivo em data/media que nenhum registro referencia).
# Por padrão o job só RELATA no log. Confira os números e ligue quando decidir.
MEDIA_LIMPEZA_ATIVA=false
MEDIA_ORFA_HORAS=48
# Teto de tamanho por arquivo de mídia recebido, em MB.
MAX_MEDIA_MB=100
